Module module() {
  return module(
    name: "micronaut.http.client",
    version: 4,
    exports: ["annotation.Client", "annotation.ClientDefinitionType", "HttpClient", "BlockingHttpClient"],
    dependencies: [dependency(repository: "norm", name: "java.base", version: 1)],
    binding: jarBinding(
      target: mavenJar(
        group: "io.micronaut",
        artifact: "micronaut-http-client-core",
        version: "5.1.13", resolution: sha256("e782e7dbae2978536b5442dd8c7437f614d284db3177c8fbdfacd189d6a3af1f")
      ),
      api: [
        jarType(
          name: "io.micronaut.http.client.annotation.Client", alias: "annotation.Client",
          members: ["alpnModes", "definitionType", "id", "path", "value"]
        ),
        jarType(name: "io.micronaut.http.client.annotation.Client.DefinitionType", alias: "annotation.ClientDefinitionType", members: []),
        jarType(
          name: "io.micronaut.http.client.HttpClient", alias: "HttpClient",
          members: ["close", "toBlocking"],
          overloads: [jarOverload(name: "create", parameterTypes: ["java.net.URL"])]
        ),
        jarType(
          name: "io.micronaut.http.client.BlockingHttpClient", alias: "BlockingHttpClient",
          members: ["close"],
          overloads: [jarOverload(name: "retrieve", parameterTypes: ["java.lang.String"])]
        )
      ]
    )
  )
}

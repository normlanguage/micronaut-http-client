import micronaut.http.client.httpClientCreate
import micronaut.http.client.BlockingHttpClient
import micronaut.http.client.HttpClient
import java.base.net.uriCreate

main() {
  HttpClient client = httpClientCreate(arg0: uriCreate("http://127.0.0.1:18770")!!.toURL())!!
  try {
    BlockingHttpClient blocking = client.toBlocking()!!
    String response = blocking.retrieve(arg0: "/greeting")!!
    require(condition: response == "Hello from Micronaut",
      message: "Unexpected local server response")
    printLine(response)
  } finally {
    client.close()
  }
}

Module module() {
  module(dependencies: [
    dependency(repository: "norm", name: "java.base", version: 1),
    dependency(repository: "github", name: "micronaut.http.client", version: 4),
    dependency(repository: "github", name: "micronaut.http.client.netty", version: 5)
  ])
}
